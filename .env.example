# Core
# Public HTTPS URL; localhost is allowed for local development.
APP_BASE_URL=
# Postgres connection URL.
DATABASE_URL=
# Restrict every outbound call to CALL_ALLOWLIST; defaults to true.
DEMO_MODE=
# Display timezone; all stored timestamps are UTC.
DEFAULT_TZ=
# Passcode for dashboard login; generated locally if absent.
ADMIN_PASSCODE=
# Bearer credential protecting mid-call tool routes.
CHASE_TOOL_SECRET=
# Credential protecting Bolna callbacks.
CHASE_WEBHOOK_SECRET=
# Credential protecting the custom LLM proxy.
CHASE_PROXY_KEY=
# Credential protecting scheduled jobs.
CRON_SECRET=
# Comma-separated E.164 numbers allowed in demo mode; empty means deny all.
CALL_ALLOWLIST=
# Demo teammate phone in E.164.
DEMO_DEBTOR_PHONE=

# Business
# Business name disclosed to debtors.
BUSINESS_NAME=
# Owner name.
OWNER_NAME=
# Owner phone in E.164; must also be allowlisted for demo calls.
OWNER_PHONE=
# Merchant UPI address for hosted payment links.
MERCHANT_UPI_VPA=
# Merchant display name on the payment page.
MERCHANT_NAME=

# Bolna
# Bolna Bearer API key; legacy BOLNA_KEY/API/TOKEN/API_NAME aliases supported.
BOLNA_API_KEY=
# Bolna API origin.
BOLNA_API_BASE=
# Optional outbound E.164 caller ID; omit to use account default.
BOLNA_FROM_NUMBER=
# Collections agent ID; created in Part 4.
BOLNA_COLLECTIONS_AGENT_ID=
# Owner brief agent ID; created in a later part.
BOLNA_BRIEF_AGENT_ID=
# Bolna agent architecture.
BOLNA_AGENT_MODE=
# Telephony provider.
BOLNA_TELEPHONY=
# Bolna voice agent LLM provider.
BOLNA_LLM_PROVIDER=
# Bolna voice agent model; confirm provider availability in Part 4.
BOLNA_LLM_MODEL=
# Speech recognition provider.
BOLNA_STT_PROVIDER=
# Speech recognition model.
BOLNA_STT_MODEL=
# Speech synthesis provider.
BOLNA_TTS_PROVIDER=
# Speech synthesis model.
BOLNA_TTS_MODEL=
# Voice name; resolve from Bolna voice catalog in Part 4.
BOLNA_TTS_VOICE=
# Voice ID; resolve from Bolna voice catalog in Part 4.
BOLNA_TTS_VOICE_ID=
# Use native Bolna LLM or Chase custom proxy.
CHASE_LLM_MODE=
# Enable owner transfer only after Part 4 safety checks.
ENABLE_TRANSFER=

# LLM
# anthropic, openai, openrouter, gemini, groq, deepseek, together, or openai_compatible.
LLM_PROVIDER=
# Optional OpenAI-compatible endpoint; required for custom provider.
LLM_BASE_URL=
# Selected LLM provider key; Anthropic may use ANTHROPIC_API_KEY.
LLM_API_KEY=
# Native Anthropic key.
ANTHROPIC_API_KEY=
# Fast model; override for selected provider.
LLM_MODEL_FAST=
# Smart model; override for selected provider.
LLM_MODEL_SMART=
# Deep reasoning model; override for selected provider.
LLM_MODEL_DEEP=
# Optional explicit fallback provider; execution added in later parts.
LLM_FALLBACK_PROVIDER=
# Optional fallback model; never silently switch providers.
LLM_FALLBACK_MODEL=

# Messaging
# Messaging adapter; console requires no account.
MESSAGING_PROVIDER=
# Meta WhatsApp access token; META_WA_ACCESS_TOKEN alias supported.
META_WA_TOKEN=
# Meta WhatsApp sender phone number ID.
META_WA_PHONE_NUMBER_ID=
# Meta webhook subscription verification token.
META_WA_VERIFY_TOKEN=
# Approved WhatsApp outbound template name.
META_WA_TEMPLATE_NAME=
# Twilio account SID.
TWILIO_ACCOUNT_SID=
# Twilio authentication token.
TWILIO_AUTH_TOKEN=
# Twilio WhatsApp sender, whatsapp:+E164.
TWILIO_WHATSAPP_FROM=
# Twilio SMS E.164 sender; TWILIO_PHONE_NUMBER alias supported.
TWILIO_SMS_FROM=

# Payments
# Hosted UPI page or Razorpay test mode.
PAYMENTS_PROVIDER=
# Razorpay test key ID.
RAZORPAY_KEY_ID=
# Razorpay test key secret.
RAZORPAY_KEY_SECRET=
# Razorpay webhook signing secret.
RAZORPAY_WEBHOOK_SECRET=
